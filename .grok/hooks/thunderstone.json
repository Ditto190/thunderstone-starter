{
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".cursor/hooks/lifecycle.sh PermissionDenied",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".cursor/hooks/lifecycle.sh StopFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".cursor/hooks/lifecycle.sh Notification",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".cursor/hooks/lifecycle.sh PostCompact",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

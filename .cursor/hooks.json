{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/run-hook.mjs .cursor/hooks/stage-router.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "node .cursor/hooks/collection-metrics.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/handoff-duplicate-guard.mjs"
      },
      {
        "command": "node .cursor/hooks/collection-metrics.mjs"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/collection-metrics.mjs"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node .cursor/hooks/collection-metrics.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/collection-metrics.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/collection-metrics.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/commit-gate.mjs",
        "matcher": "git(\\s+|\\.exe\\s+)commit|checkpoint\\.sh|ALLOW_LOCAL_COMMITS=1",
        "failClosed": false,
        "timeout": 20
      }
    ]
  }
}

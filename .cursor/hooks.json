{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/stage-router.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": ".cursor/hooks/collection-metrics.sh"
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/handoff-duplicate-guard.sh"
      },
      {
        "command": ".cursor/hooks/collection-metrics.sh"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/collection-metrics.sh"
      }
    ],
    "postToolUseFailure": [
      {
        "command": ".cursor/hooks/collection-metrics.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/collection-metrics.sh"
      }
    ]
  }
}

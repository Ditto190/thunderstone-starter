# Copy these keys into .env.local (never commit real values).
# Cursor My Machines worker: Cloud Agent tools run on this checkout on the Grok VM.

# Stable name shown in Cursor → My Machines (also use worker=<name> in triggers).
CURSOR_WORKER_NAME=grok-shared

# Git checkout the worker may edit (defaults to repo root when unset).
# CURSOR_WORKER_DIR=

# tmux session for the long-running worker process.
CURSOR_WORKER_SESSION=thunderstone-worker

# Set to 1 so scripts/resume.sh starts the worker when absent (opt-in).
CURSOR_WORKER_AUTOSTART=0

# Set to 1 to pass --computer-use to agent worker (Xfce / browser automation).
CURSOR_WORKER_COMPUTER_USE=0

# CURSOR_API_KEY=   # optional; otherwise run `agent login` once on the VM

# Copy these settings into .env.local or provide them through your runtime environment.
INFISICAL_PROJECT_ID=replace-with-project-id
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/coding

# Set only when using EU Cloud, a dedicated instance, or self-hosting.
# INFISICAL_DOMAIN=https://your-infisical-instance.example

# For unattended hosts, provide machine identity credentials through the host's
# protected runtime-secret facility, not in a committed file.
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

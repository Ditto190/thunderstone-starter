{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/run-hook.mjs .codex/hooks/stage-router.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/collection-metrics.mjs"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/handoff-duplicate-guard.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/collection-metrics.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/collection-metrics.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/collection-metrics.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/collection-metrics.mjs"
          }
        ]
      }
    ]
  }
}

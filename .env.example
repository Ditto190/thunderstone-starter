# Names only. Copy to .env.local or ~/.config/thunderstone/env; never commit real values.
# Key registry: config/env.registry.json — Infisical/Doppler: docs/env-surfaces.md
THUNDERSTONE_SECRETS_BACKEND=
CURSOR_API_KEY=
CONTEXT7_API_KEY=
RCLONE_CONFIG=
DRIVE_EXPORT_ROOT=
ALLOW_LOCAL_COMMITS=
# Infisical (primary secret manager)
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=
# Doppler (alternate secret manager)
DOPPLER_TOKEN=
DOPPLER_PROJECT=
DOPPLER_CONFIG=
# Cursor My Machines bridge (see config/cursor-worker.example.env)
CURSOR_WORKER_AUTOSTART=
CURSOR_WORKER_COMPUTER_USE=

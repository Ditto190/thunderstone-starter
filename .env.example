CURSOR_API_KEY=
RCLONE_CONFIG=
DRIVE_EXPORT_ROOT=
ALLOW_LOCAL_COMMITS=0
# ---------------------------------------------------------------------------
# SECURITY: copy to .env (gitignored), then `chmod 600 .env`. Never commit values.
# Prefer the VM secret store; scripts/env-run.mjs injects env at runtime only.
# ---------------------------------------------------------------------------
# Perplexity API MCP (perplexity_search/ask/research/reason) + Agent API.
# Create at console.perplexity.ai > API Keys, in a dedicated API Project per VM
# so it can be revoked alone. Set a monthly spend cap on that Project.
PERPLEXITY_API_KEY=
# Optional: request timeout for long perplexity_research calls (ms)
PERPLEXITY_TIMEOUT_MS=600000
# Perplexity Computer MCP: OAuth 2.0 via your Perplexity account, NO key here.
# Endpoint (not secret): https://www.perplexity.ai/rest/computer/mcp
# Usage bills account credits; OAuth tokens live in the MCP client's own store.
# Research / repo tooling
FIRECRAWL_API_KEY=
CONTEXT7_API_KEY=
# Fine-grained PAT scoped to this repo only (contents + pull requests)
GH_TOKEN=

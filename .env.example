# Names only. Copy to .env.local and set values locally; never commit real values.
CURSOR_API_KEY=
RCLONE_CONFIG=
DRIVE_EXPORT_ROOT=
ALLOW_LOCAL_COMMITS=
# Agent connectors (Grok, Grok Bot, Cursor). See docs/agent-connectors/README.md
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=
CONTEXT7_API_KEY=
# dev (default) or vm. The Grok Bot VM sets vm in ~/.config/thunderstone/env
THUNDERSTONE_PROFILE=
# Comma lists of MCP server ids from config/mcp/servers.json
MCP_ENABLE=
MCP_DISABLE=

{
  "hooks": {
    "preCompact": [
      {
        "command": "$HOME/.local/bin/lean-ctx hook observe"
      }
    ],
    "preToolUse": [
      {
        "command": "$HOME/.local/bin/lean-ctx hook rewrite",
        "matcher": "Shell"
      },
      {
        "command": "$HOME/.local/bin/lean-ctx hook deny",
        "matcher": "Grep|Glob"
      },
      {
        "command": "$HOME/.local/bin/lean-ctx hook redirect",
        "matcher": "Read"
      },
      {
        "command": "$HOME/.local/bin/lean-ctx hook deny",
        "matcher": "StrReplace|Write|Edit|EditNotebook|MultiEdit"
      }
    ],
    "sessionStart": [
      {
        "command": "$HOME/.local/bin/lean-ctx hook observe"
      },
      {
        "command": "bash $WORKSPACE_ROOT/thunderstone/scripts/health.sh --bg",
        "failClosed": false,
        "timeout": 5,
        "timeoutSec": 5
      }
    ]
  },
  "version": 1
}
